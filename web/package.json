{
  "name": "love-language-model-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web shell for Love Language Model: Python runs in your browser (Pyodide in a Web Worker).",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && vite build",
    "preview": "vite preview",
    "smoke": "npm run prepare-assets && node scripts/smoke.mjs",
    "test": "node --test",
    "e2e": "playwright test",
    "media": "node scripts/make-readme-media.mjs"
  },
  "devDependencies": {
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "pyodide": "0.29.5",
    "vite": "8.3.8"
  }
}
